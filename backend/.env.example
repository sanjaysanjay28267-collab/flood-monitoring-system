# BACKEND - Node.js Environment Variables

# Server Configuration
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/flood-monitoring
MONGODB_ATLAS_URI=your_mongodb_atlas_connection_string_here

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRE=7d

# Firebase Admin SDK
FIREBASE_PROJECT_ID=your_firebase_project_id_here
FIREBASE_PRIVATE_KEY=your_firebase_private_key_here
FIREBASE_CLIENT_EMAIL=your_firebase_client_email_here

# Twilio
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# EmailJS/Email Configuration
EMAILJS_SERVICE_ID=your_emailjs_service_id_here
EMAILJS_TEMPLATE_ID=your_emailjs_template_id_here
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password_here

# APIs
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
OPENWEATHER_API_KEY=your_openweather_api_key_here
RAINVIEWER_API_KEY=your_rainviewer_api_key_here
GOOGLE_GEMINI_API_KEY=your_google_gemini_api_key_here

# ThingSpeak
THINGSPEAK_API_KEY=your_thingspeak_api_key_here
THINGSPEAK_CHANNEL_ID=your_thingspeak_channel_id_here

# MQTT
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USERNAME=mqtt_user
MQTT_PASSWORD=mqtt_password

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Session
SESSION_SECRET=your_session_secret_key_here
