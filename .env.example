# FRONTEND (.env file should be placed in frontend/ directory)

# Google Maps API
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
VITE_GOOGLE_GEOLOCATION_API_KEY=your_google_geolocation_api_key_here

# Weather APIs
VITE_OPENWEATHER_API_KEY=your_openweather_api_key_here
VITE_RAINVIEWER_API_KEY=your_rainviewer_api_key_here

# Firebase
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_firebase_auth_domain_here
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id_here
VITE_FIREBASE_STORAGE_BUCKET=your_firebase_storage_bucket_here
VITE_FIREBASE_MESSAGING_SENDER_ID=your_firebase_messaging_sender_id_here
VITE_FIREBASE_APP_ID=your_firebase_app_id_here

# Backend API
VITE_API_URL=http://localhost:5000
VITE_API_SOCKET_URL=http://localhost:5000

# Google Gemini AI
VITE_GOOGLE_GEMINI_API_KEY=your_google_gemini_api_key_here

---

# BACKEND (.env file should be placed in backend/ directory)

# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/flood-monitoring
MONGODB_ATLAS_URI=your_mongodb_atlas_connection_string_here

# JWT Secret
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRE=7d

# Firebase Admin SDK
FIREBASE_PROJECT_ID=your_firebase_project_id_here
FIREBASE_PRIVATE_KEY=your_firebase_private_key_here
FIREBASE_CLIENT_EMAIL=your_firebase_client_email_here

# Twilio SMS
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# EmailJS
EMAILJS_SERVICE_ID=your_emailjs_service_id_here
EMAILJS_TEMPLATE_ID=your_emailjs_template_id_here
EMAILJS_PUBLIC_KEY=your_emailjs_public_key_here

# Google Maps & Geolocation APIs
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
GOOGLE_GEOLOCATION_API_KEY=your_google_geolocation_api_key_here

# Weather APIs
OPENWEATHER_API_KEY=your_openweather_api_key_here
RAINVIEWER_API_KEY=your_rainviewer_api_key_here
OPEN_METEO_API_KEY=your_open_meteo_api_key_here

# ThingSpeak IoT
THINGSPEAK_API_KEY=your_thingspeak_api_key_here
THINGSPEAK_CHANNEL_ID=your_thingspeak_channel_id_here

# MQTT Broker
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USERNAME=mqtt_user
MQTT_PASSWORD=mqtt_password

# Google Gemini AI
GOOGLE_GEMINI_API_KEY=your_google_gemini_api_key_here

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Session
SESSION_SECRET=your_session_secret_key_here
